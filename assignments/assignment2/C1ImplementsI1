interface I1 {
    int n = 10;

    void display();
}

class C implements I1 {

    @Override
    public void display() {
        System.out.println("This is from interface I1");
        System.out.println("Square of n is : " + (n * n));
    }
}

public class C1ImplementsI1 {
    public static void main(String[] args) {
        
        C obj=new C();
        obj.display();
    }
}
