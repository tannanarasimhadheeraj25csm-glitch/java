
package javacore;

class PalindromeInt {
	void check () {
	int num = 1010101;
	int original = num;
	int rev  = 0;
	while (num != 0) {
		int digit = num % 10;
		rev = rev * 10 + digit;
		num = num/10;
	}
	if (original == rev) {
		System.out.println("integer is palindrome");
	} else {
		System.out.println("interger is not palindrome");
	}
	}
}
class PalindromeStr {
	void check (String name) {
		String n = name;
		 String rev = "";
		 for (int i = n.length() -1; i >= 0; i--) {
			 rev += n.charAt(i);
		}
		 if (n.equals(rev)) {
			 System.out.println("string is palindrome");
		 } else {
			 System.out.println("string is not a palindrome");
		 }
	}
}


